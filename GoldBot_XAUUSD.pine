//@version=5
// ╔══════════════════════════════════════════════════════════╗
// ║  GoldBot — AMD x iFVG (Smart Money)                        ║
// ║  Strategia UNICA, pulita:                                  ║
// ║   1) ACCUMULO    → range delle ultime N candele            ║
// ║   2) MANIPOLAZIONE → sweep (il prezzo rompe il range e      ║
// ║      rientra = prende gli stop / trappola)                 ║
// ║   3) iFVG/DISTRIBUZIONE → si forma un Fair Value Gap nel   ║
// ║      verso opposto → ENTRATA, target il lato opposto.      ║
// ╚══════════════════════════════════════════════════════════╝
strategy("GoldBot AMD x iFVG", shorttitle="GoldBot AMD", overlay=true,
  default_qty_type=strategy.percent_of_equity, default_qty_value=10,
  commission_type=strategy.commission.cash_per_contract, commission_value=0.35,
  slippage=5, process_orders_on_close=true,
  pyramiding=20,
  max_labels_count=500, max_boxes_count=500)

// ─── AMD (Accumulo · Manipolazione · Distribuzione) ────────
range_len   = input.int(20, "Range accumulo (barre)", group="AMD", minval=5, maxval=200, tooltip="Quante candele indietro guardare per definire il range di accumulo (massimo e minimo). Il prezzo deve rompere questo range per 'manipolare'.")
sweep_valid = input.int(5,  "Validità sweep (barre)", group="AMD", minval=1, maxval=30, tooltip="Dopo che il prezzo ha spazzato il range (sweep), quante candele restano valide per cercare il Fair Value Gap ed entrare. Passate queste, lo sweep scade.")
require_back_in = input.bool(true, "Sweep deve rientrare nel range", group="AMD", tooltip="ON = lo sweep conta solo se la candela ROMPE il range con la mecha ma CHIUDE di nuovo dentro (vera trappola). OFF = basta che rompa il range (piu entrate, meno selettivo).")

// ─── iFVG (Fair Value Gap = squilibrio dell'impulso) ───────
use_fvg     = input.bool(true, "Richiedi Fair Value Gap (iFVG)", group="iFVG", tooltip="ON = entra solo se dopo lo sweep si forma un Fair Value Gap nel verso dell'inversione (impulso forte = mano forte che entra). OFF = entra appena il prezzo riparte dopo lo sweep (piu entrate).")

// ─── DIREZIONE / BIAS (opzionale) ──────────────────────────
use_bias    = input.bool(false, "Solo nel verso del trend (EMA 200)", group="Direzione", tooltip="ON = compra solo sopra la EMA200 e vende solo sotto (filtro di tendenza di fondo). OFF = AMD puro nei due sensi.")
bias_len    = input.int(200, "Periodo EMA bias", group="Direzione", minval=20, maxval=400)

// ─── RISCHIO / USCITE ──────────────────────────────────────
risk_pct    = input.float(0.5, "Rischio % per trade", group="Rischio", minval=0.1, maxval=3.0, step=0.1)
sl_buf      = input.float(0.5, "SL buffer ATR oltre lo sweep", group="Rischio", minval=0.0, maxval=3.0, step=0.1, tooltip="Lo stop loss va appena oltre il punto spazzato (la mecha della trappola) piu questo cuscinetto in ATR.")
tp1_r       = input.float(1.5, "TP1 in multipli di rischio (R)", group="Rischio", minval=0.3, maxval=10.0, step=0.1)
tp1_pct     = input.float(50,  "% chiusura a TP1", group="Rischio", minval=10, maxval=90)
use_be      = input.bool(true, "Break-even dopo TP1", group="Rischio")
use_trail   = input.bool(true, "Trailing stop ATR dopo TP1", group="Rischio")
trail_mult  = input.float(2.0, "Trailing ATR mult", group="Rischio", minval=0.5, maxval=6.0, step=0.1)
use_rr      = input.bool(true, "Filtro R:R minimo (target/SL)", group="Rischio")
min_rr      = input.float(1.5, "R:R minimo", group="Rischio", minval=0.5, maxval=10.0, step=0.1)

// ─── FILTRO ORARIO (opzionale) ─────────────────────────────
use_session = input.bool(false, "Filtra orario (Londra/NY)", group="Filtri", tooltip="ON = opera solo tra le ore indicate (ora di Roma). OFF = 24h.")
start_hour  = input.int(9,  "Ora inizio (Roma)", group="Filtri", minval=0, maxval=23)
end_hour    = input.int(20, "Ora fine (Roma)",   group="Filtri", minval=0, maxval=23)

show_levels = input.bool(true, "Disegna range/SL/TP", group="Grafica")

// ─── VIA LIBERA (trade liberi, niente blocchi) ─────────────
free_mode = input.bool(true, "🚀 Via libera (trade liberi, niente blocchi)", group="Libero", tooltip="ON = il bot apre i trade liberamente: piu posizioni SOVRAPPOSTE (fino al max sotto) e NESSUN filtro R:R che blocca. ⚠️ Una strategia TradingView non puo essere long e short insieme: i trade multipli sono solo nello stesso verso. ⚠️ Piu trade aperti = piu rischio nello stesso momento. OFF = un trade alla volta col filtro R:R.")
max_open  = input.int(5, "Max trade aperti insieme", group="Libero", minval=1, maxval=20, tooltip="Quanti trade puo tenere aperti contemporaneamente quando la Via libera e ON.")

// ─── DATI BASE ─────────────────────────────────────────────
atr = ta.atr(14)
ema_bias = ta.ema(close, bias_len)

// ─── 1) RANGE DI ACCUMULO ──────────────────────────────────
range_high = ta.highest(high, range_len)[1]
range_low  = ta.lowest(low,  range_len)[1]

// ─── 2) MANIPOLAZIONE: SWEEP DEL RANGE ─────────────────────
sweep_low_now  = low  < range_low  and (not require_back_in or close > range_low)   // spazza i minimi (liquidita sell-side)
sweep_high_now = high > range_high and (not require_back_in or close < range_high)  // spazza i massimi (liquidita buy-side)

var int   swept_dir = 0     // 1 = atteso BUY (spazzato il basso), -1 = atteso SELL
var int   swept_bar = 0
var float swept_px  = na
if sweep_low_now
    swept_dir := 1
    swept_bar := bar_index
    swept_px  := low
if sweep_high_now
    swept_dir := -1
    swept_bar := bar_index
    swept_px  := high
sweep_fresh = swept_dir != 0 and (bar_index - swept_bar) <= sweep_valid

// ─── 3) iFVG: FAIR VALUE GAP NEL VERSO DELL'INVERSIONE ─────
bull_fvg = low  > high[2]   // gap rialzista: impulso su che lascia squilibrio
bear_fvg = high < low[2]    // gap ribassista
fvg_ok_buy  = not use_fvg or bull_fvg
fvg_ok_sell = not use_fvg or bear_fvg

// ─── DIREZIONE + ORARIO ────────────────────────────────────
bias_ok_buy  = not use_bias or close > ema_bias
bias_ok_sell = not use_bias or close < ema_bias
h_now   = hour(time, "Europe/Rome")
sess_ok = not use_session or (h_now >= start_hour and h_now < end_hour)

// ─── SL/TP CANDIDATI + R:R ─────────────────────────────────
sl_buy_calc  = swept_px - atr * sl_buf
sl_sell_calc = swept_px + atr * sl_buf
risk_buy  = close - sl_buy_calc
risk_sell = sl_sell_calc - close
rr_buy  = risk_buy  > 0 ? (range_high - close) / risk_buy  : 0.0
rr_sell = risk_sell > 0 ? (close - range_low)  / risk_sell : 0.0
rr_ok_buy  = not use_rr or free_mode or rr_buy  >= min_rr
rr_ok_sell = not use_rr or free_mode or rr_sell >= min_rr

// ─── SEGNALI FINALI ────────────────────────────────────────
// Via libera ON = piu trade sovrapposti (stesso verso) fino a max_open, niente
// filtro R:R. OFF = un solo trade alla volta col filtro R:R.
can_buy  = free_mode ? (strategy.position_size >= 0 and strategy.opentrades < max_open) : strategy.position_size == 0
can_sell = free_mode ? (strategy.position_size <= 0 and strategy.opentrades < max_open) : strategy.position_size == 0
buy_signal  = can_buy  and sweep_fresh and swept_dir == 1  and fvg_ok_buy  and bias_ok_buy  and sess_ok and risk_buy  > 0 and rr_ok_buy
sell_signal = can_sell and sweep_fresh and swept_dir == -1 and fvg_ok_sell and bias_ok_sell and sess_ok and risk_sell > 0 and rr_ok_sell

// ─── SIZING ────────────────────────────────────────────────
f_qty(_sl_dist) =>
    risk_cash = strategy.equity * (risk_pct / 100.0)
    _sl_dist > 0 ? risk_cash / _sl_dist : 0.0

// ─── STATO POSIZIONE ───────────────────────────────────────
var float pos_sl    = na
var float pos_tp1   = na
var float pos_tp2   = na
var float pos_entry = na
var int   pos_dir   = 0
var bool  be_active = false
var float trail_sl  = na
var int   last_buy_bar  = 0
var int   last_sell_bar = 0
var box b_tp = na
var box b_sl = na

// ─── ENTRATE ───────────────────────────────────────────────
if buy_signal
    pos_entry := close
    pos_sl    := sl_buy_calc
    pos_tp1   := close + tp1_r * risk_buy
    pos_tp2   := range_high
    pos_dir   := 1
    be_active := false
    last_buy_bar := bar_index
    swept_dir := 0
    strategy.entry("LONG", strategy.long, qty=f_qty(risk_buy))
    strategy.exit("LONG_X", from_entry="LONG", stop=pos_sl, limit=pos_tp2)
    if show_levels
        box.delete(b_tp), box.delete(b_sl)
        b_tp := box.new(bar_index, pos_entry, bar_index+40, pos_tp2, bgcolor=color.new(color.green,80), border_color=color.new(color.green,40))
        b_sl := box.new(bar_index, pos_sl,    bar_index+40, pos_entry, bgcolor=color.new(color.red,80),  border_color=color.new(color.red,40))
    alert("🟢 GoldBot AMD BUY\nEntry: " + str.tostring(pos_entry,"#.##") + "\nSL: " + str.tostring(pos_sl,"#.##") + "\nTP1: " + str.tostring(pos_tp1,"#.##") + "\nTP2: " + str.tostring(pos_tp2,"#.##"), alert.freq_once_per_bar_close)

if sell_signal
    pos_entry := close
    pos_sl    := sl_sell_calc
    pos_tp1   := close - tp1_r * risk_sell
    pos_tp2   := range_low
    pos_dir   := -1
    be_active := false
    last_sell_bar := bar_index
    swept_dir := 0
    strategy.entry("SHORT", strategy.short, qty=f_qty(risk_sell))
    strategy.exit("SHORT_X", from_entry="SHORT", stop=pos_sl, limit=pos_tp2)
    if show_levels
        box.delete(b_tp), box.delete(b_sl)
        b_tp := box.new(bar_index, pos_tp2,    bar_index+40, pos_entry, bgcolor=color.new(color.green,80), border_color=color.new(color.green,40))
        b_sl := box.new(bar_index, pos_entry,  bar_index+40, pos_sl, bgcolor=color.new(color.red,80),  border_color=color.new(color.red,40))
    alert("🔴 GoldBot AMD SELL\nEntry: " + str.tostring(pos_entry,"#.##") + "\nSL: " + str.tostring(pos_sl,"#.##") + "\nTP1: " + str.tostring(pos_tp1,"#.##") + "\nTP2: " + str.tostring(pos_tp2,"#.##"), alert.freq_once_per_bar_close)

// ─── TP1 PARZIALE + BREAK-EVEN + TRAILING ──────────────────
if strategy.position_size > 0 and not be_active and not na(pos_tp1) and high >= pos_tp1
    strategy.close("LONG", qty_percent=tp1_pct, comment="TP1")
    if use_be
        be_active := true
        trail_sl  := pos_entry
        strategy.exit("LONG_X", from_entry="LONG", stop=trail_sl, limit=pos_tp2)

if strategy.position_size < 0 and not be_active and not na(pos_tp1) and low <= pos_tp1
    strategy.close("SHORT", qty_percent=tp1_pct, comment="TP1")
    if use_be
        be_active := true
        trail_sl  := pos_entry
        strategy.exit("SHORT_X", from_entry="SHORT", stop=trail_sl, limit=pos_tp2)

if use_trail and be_active
    if strategy.position_size > 0 and not na(trail_sl)
        new_sl = close - atr * trail_mult
        if new_sl > trail_sl
            trail_sl := new_sl
            strategy.exit("LONG_X", from_entry="LONG", stop=trail_sl, limit=pos_tp2)
    if strategy.position_size < 0 and not na(trail_sl)
        new_sl = close + atr * trail_mult
        if new_sl < trail_sl
            trail_sl := new_sl
            strategy.exit("SHORT_X", from_entry="SHORT", stop=trail_sl, limit=pos_tp2)

if strategy.position_size == 0
    trail_sl  := na
    be_active := false

// ─── GRAFICA ───────────────────────────────────────────────
plot(show_levels ? range_high : na, "Range High", color=color.new(color.gray, 30), style=plot.style_linebr)
plot(show_levels ? range_low  : na, "Range Low",  color=color.new(color.gray, 30), style=plot.style_linebr)
plot(use_bias ? ema_bias : na, "EMA bias", color=color.new(color.orange, 50))

plotshape(sweep_low_now,  title="Sweep basso",  style=shape.triangleup,   location=location.belowbar, color=color.new(color.aqua,0),   size=size.tiny, text="sw")
plotshape(sweep_high_now, title="Sweep alto",   style=shape.triangledown, location=location.abovebar, color=color.new(color.orange,0), size=size.tiny, text="sw")
plotshape(bar_index == last_buy_bar,  title="BUY",  style=shape.labelup,   location=location.belowbar, color=color.lime, textcolor=color.black, size=size.normal, text="BUY")
plotshape(bar_index == last_sell_bar, title="SELL", style=shape.labeldown, location=location.abovebar, color=color.red,  textcolor=color.white, size=size.normal, text="SELL")

// ─── PANNELLO STATO ────────────────────────────────────────
var table p = table.new(position.middle_left, 2, 8, bgcolor=color.new(color.black,70), border_width=1, border_color=color.new(color.yellow,60))
if barstate.islast
    table.cell(p, 0, 0, "GoldBot AMD x iFVG", text_color=color.yellow, text_size=size.small, bgcolor=color.new(color.black,50))
    table.cell(p, 1, 0, "", bgcolor=color.new(color.black,50))
    table.cell(p, 0, 1, "Range", text_color=color.gray, text_size=size.tiny)
    table.cell(p, 1, 1, str.tostring(math.round(range_low,2)) + " - " + str.tostring(math.round(range_high,2)), text_color=color.silver, text_size=size.tiny)
    table.cell(p, 0, 2, "Sweep", text_color=color.gray, text_size=size.tiny)
    sweep_txt = not sweep_fresh ? "─ nessuno" : swept_dir == 1 ? "🔻 BASSO -> cerca BUY" : "🔺 ALTO -> cerca SELL"
    table.cell(p, 1, 2, sweep_txt, text_color=sweep_fresh ? color.aqua : color.gray, text_size=size.tiny)
    table.cell(p, 0, 3, "FVG", text_color=color.gray, text_size=size.tiny)
    table.cell(p, 1, 3, (bull_fvg ? "🟢 rialzista" : bear_fvg ? "🔴 ribassista" : "─"), text_color=bull_fvg ? color.lime : bear_fvg ? color.red : color.gray, text_size=size.tiny)
    table.cell(p, 0, 4, "Bias EMA" + str.tostring(bias_len), text_color=color.gray, text_size=size.tiny)
    table.cell(p, 1, 4, use_bias ? (close > ema_bias ? "RIALZO ▲" : "RIBASSO ▼") : "OFF", text_color=use_bias ? (close > ema_bias ? color.lime : color.red) : color.gray, text_size=size.tiny)
    table.cell(p, 0, 5, "Orario", text_color=color.gray, text_size=size.tiny)
    table.cell(p, 1, 5, sess_ok ? "✅ aperto" : "🛑 chiuso", text_color=sess_ok ? color.lime : color.orange, text_size=size.tiny)
    table.cell(p, 0, 6, "Posizione", text_color=color.gray, text_size=size.tiny)
    pos_tag = be_active ? (use_trail ? " TRAIL" : " BE") : ""
    table.cell(p, 1, 6, strategy.position_size > 0 ? "LONG 🟢" + pos_tag : strategy.position_size < 0 ? "SHORT 🔴" + pos_tag : "FLAT ⚪", text_color=strategy.position_size > 0 ? color.lime : strategy.position_size < 0 ? color.red : color.white, text_size=size.tiny)
    table.cell(p, 0, 7, "SL / TP1 / TP2", text_color=color.gray, text_size=size.tiny)
    sl_d  = strategy.position_size != 0 and not na(trail_sl) ? str.tostring(math.round(trail_sl,2)) : not na(pos_sl) and strategy.position_size != 0 ? str.tostring(math.round(pos_sl,2)) : "─"
    tp1_d = strategy.position_size != 0 ? str.tostring(math.round(pos_tp1,2)) : "─"
    tp2_d = strategy.position_size != 0 ? str.tostring(math.round(pos_tp2,2)) : "─"
    table.cell(p, 1, 7, sl_d + " / " + tp1_d + " / " + tp2_d, text_color=color.silver, text_size=size.tiny)

// ─── TABELLA STATISTICHE BACKTEST ──────────────────────────
var table stats = table.new(position.top_right, 2, 12, bgcolor=color.new(color.black,70), border_width=1, border_color=color.new(color.aqua,60))
if barstate.islast
    closed     = strategy.closedtrades
    wins       = strategy.wintrades
    losses     = strategy.losstrades
    win_rate   = closed > 0 ? wins / closed * 100 : 0.0
    gross_prof = strategy.grossprofit
    gross_loss = strategy.grossloss
    prof_fact  = gross_loss > 0 ? gross_prof / gross_loss : na
    net_prof   = strategy.netprofit
    net_pct    = strategy.initial_capital > 0 ? net_prof / strategy.initial_capital * 100 : 0.0
    max_dd     = strategy.max_drawdown
    max_dd_pct = strategy.initial_capital > 0 ? max_dd / strategy.initial_capital * 100 : 0.0
    avg_trade  = closed > 0 ? net_prof / closed : 0.0
    avg_win    = wins   > 0 ? gross_prof / wins   : 0.0
    avg_loss   = losses > 0 ? gross_loss / losses : 0.0
    rr_ratio   = avg_loss > 0 ? avg_win / avg_loss : na
    expectancy = (win_rate/100) * avg_win - (1 - win_rate/100) * avg_loss
    grade = closed < 10 ? "⚪ POCHI DATI" : prof_fact >= 2.0 and win_rate >= 50 ? "🟢 OTTIMA" : prof_fact >= 1.5 ? "🟡 BUONA" : prof_fact >= 1.0 ? "🟠 OK" : "🔴 PERDENTE"
    grade_color = closed < 10 ? color.gray : prof_fact >= 1.5 ? color.lime : prof_fact >= 1.0 ? color.yellow : color.red
    table.cell(stats, 0, 0,  "📊 BACKTEST",  text_color=color.aqua,   text_size=size.small, bgcolor=color.new(color.black,50))
    table.cell(stats, 1, 0,  "AMD x iFVG",    text_color=color.silver, text_size=size.tiny,  bgcolor=color.new(color.black,50))
    table.cell(stats, 0, 1,  "Giudizio",     text_color=color.gray, text_size=size.tiny)
    table.cell(stats, 1, 1,  grade,          text_color=grade_color, text_size=size.tiny)
    table.cell(stats, 0, 2,  "Net Profit",   text_color=color.gray, text_size=size.tiny)
    table.cell(stats, 1, 2,  "$" + str.tostring(math.round(net_prof,2)) + " (" + str.tostring(math.round(net_pct,2)) + "%)", text_color=net_prof >= 0 ? color.lime : color.red, text_size=size.tiny)
    table.cell(stats, 0, 3,  "Trade Totali", text_color=color.gray, text_size=size.tiny)
    table.cell(stats, 1, 3,  str.tostring(closed) + " (W:" + str.tostring(wins) + " L:" + str.tostring(losses) + ")", text_color=color.white, text_size=size.tiny)
    table.cell(stats, 0, 4,  "Win Rate",     text_color=color.gray, text_size=size.tiny)
    table.cell(stats, 1, 4,  str.tostring(math.round(win_rate,1)) + "%", text_color=win_rate >= 50 ? color.lime : win_rate >= 40 ? color.yellow : color.red, text_size=size.tiny)
    table.cell(stats, 0, 5,  "Profit Factor",text_color=color.gray, text_size=size.tiny)
    table.cell(stats, 1, 5,  na(prof_fact) ? "─" : str.tostring(math.round(prof_fact,2)), text_color=na(prof_fact) ? color.gray : prof_fact >= 1.5 ? color.lime : prof_fact >= 1.0 ? color.yellow : color.red, text_size=size.tiny)
    table.cell(stats, 0, 6,  "Max Drawdown", text_color=color.gray, text_size=size.tiny)
    table.cell(stats, 1, 6,  "$" + str.tostring(math.round(max_dd,2)) + " (" + str.tostring(math.round(max_dd_pct,2)) + "%)", text_color=max_dd_pct < 10 ? color.lime : max_dd_pct < 20 ? color.yellow : color.red, text_size=size.tiny)
    table.cell(stats, 0, 7,  "Avg Trade",    text_color=color.gray, text_size=size.tiny)
    table.cell(stats, 1, 7,  "$" + str.tostring(math.round(avg_trade,2)), text_color=avg_trade >= 0 ? color.lime : color.red, text_size=size.tiny)
    table.cell(stats, 0, 8,  "Avg Win/Loss", text_color=color.gray, text_size=size.tiny)
    table.cell(stats, 1, 8,  "$" + str.tostring(math.round(avg_win,1)) + " / $" + str.tostring(math.round(avg_loss,1)), text_color=color.silver, text_size=size.tiny)
    table.cell(stats, 0, 9,  "R/R Ratio",    text_color=color.gray, text_size=size.tiny)
    table.cell(stats, 1, 9,  na(rr_ratio) ? "─" : str.tostring(math.round(rr_ratio,2)) + ":1", text_color=na(rr_ratio) ? color.gray : rr_ratio >= 1.5 ? color.lime : color.yellow, text_size=size.tiny)
    table.cell(stats, 0, 10, "Expectancy",   text_color=color.gray, text_size=size.tiny)
    table.cell(stats, 1, 10, "$" + str.tostring(math.round(expectancy,2)) + "/trade", text_color=expectancy >= 0 ? color.lime : color.red, text_size=size.tiny)
    table.cell(stats, 0, 11, "Regola", text_color=color.gray, text_size=size.tiny)
    table.cell(stats, 1, 11, "100+ trade = affidabile", text_color=color.gray, text_size=size.tiny)
