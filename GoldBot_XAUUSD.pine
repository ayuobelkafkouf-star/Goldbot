//@version=5
strategy("GoldBot XAUUSD ICT", shorttitle="GoldBot ICT", overlay=true,
  default_qty_type=strategy.percent_of_equity, default_qty_value=10,
  commission_type=strategy.commission.cash_per_contract, commission_value=0.35,
  slippage=5, margin_long=100, margin_short=100,
  calc_on_every_tick=false, process_orders_on_close=true)

// ─── INPUTS ───────────────────────────────────────────────
mode = input.string("Conservativo", "Modalità operativa",
   options=["Conservativo", "Sessione Estesa", "Aggressivo"],
   group="Modalità",
   tooltip="Conservativo: solo overlap 13-17, max 5 trade/g. Sessione Estesa: 8-20, max 5 trade/g. Aggressivo: 8-20, max 10 trade/g, cooldown 2.")

// ─── ICT: LIQUIDITY SWEEP + CiSD ──────────────────────────
liq_lookback   = input.int(20, "Barre lookback pool liquidità", group="ICT: Liquidity Sweep + CiSD", minval=5, maxval=100)
liq_buffer_atr = input.float(0.1, "Buffer sweep oltre livello (ATR)", group="ICT: Liquidity Sweep + CiSD", minval=0.0, maxval=1.0, step=0.05)
cisd_body_mult = input.float(0.3, "Displacement: corpo minimo CiSD (ATR)", group="ICT: Liquidity Sweep + CiSD", minval=0.0, maxval=2.0, step=0.05, tooltip="Il bar che rigetta deve avere un corpo direzionale (displacement) di almeno questa frazione di ATR = Change in State of Delivery.")

risk_pct    = input.float(0.5, "Rischio % per trade", group="Rischio", minval=0.1, maxval=3.0, step=0.1)
sl_atr_mult = input.float(0.4, "SL buffer ATR", group="Rischio", minval=0.1, maxval=2.0, step=0.1)
tp1_pct     = input.float(70,  "% chiusura TP1", group="Rischio", minval=10, maxval=90)
use_be      = input.bool(true, "Break-even dopo TP1", group="Rischio")
use_trail   = input.bool(true, "Trailing stop ATR dopo TP1", group="Rischio")
trail_mult  = input.float(1.5, "Trailing ATR mult", group="Rischio", minval=0.5, maxval=5.0, step=0.1)

use_session   = input.bool(true, "Filtro sessione London/NY overlap", group="Filtri")
session_start = input.int(13, "Sessione start (Roma)", group="Filtri", minval=0, maxval=23)
session_end   = input.int(17, "Sessione end (Roma)",   group="Filtri", minval=0, maxval=23)
use_hours  = input.bool(false, "Filtra orari (fallback se sessione OFF)", group="Filtri")
start_hour = input.int(8,  "Ora inizio", group="Filtri")
end_hour   = input.int(20, "Ora fine",   group="Filtri")

use_circuit  = input.bool(true, "Circuit breaker drawdown", group="Protezione")
dd_threshold = input.float(5.0, "DD max % dal peak", group="Protezione", minval=1.0, maxval=20.0, step=0.5)
pause_days   = input.int(3,    "Giorni pausa dopo trigger", group="Protezione", minval=1, maxval=14)
use_atr    = input.bool(true, "Filtro ATR", group="Filtri")
atr_min    = input.float(1.5, "ATR minimo", group="Filtri")
cooldown_bars  = input.int(5, "Cooldown barre", group="Filtri")
max_trades_day = input.int(5, "Max trade giorno", group="Filtri")
max_loss   = input.float(1.0, "Max perdita % giorno", group="Filtri")
max_profit = input.float(5.0, "Max profitto % giorno", group="Filtri")

use_news     = input.bool(true, "Filtro notizie", group="Notizie")
news1_active = input.bool(true,  "NFP/CPI 1", group="Notizie")
news1_hour   = input.int(14, "Ora notizia 1", group="Notizie")
news1_min    = input.int(30, "Min notizia 1", group="Notizie")
news2_active = input.bool(false, "Notizia 2 (FOMC)", group="Notizie")
news2_hour   = input.int(20, "Ora notizia 2", group="Notizie")
news2_min    = input.int(0,  "Min notizia 2", group="Notizie")
news3_active = input.bool(false, "Notizia 3", group="Notizie")
news3_hour   = input.int(16, "Ora notizia 3", group="Notizie")
news3_min    = input.int(0,  "Min notizia 3", group="Notizie")
news_before  = input.int(30, "Minuti prima", group="Notizie")
news_after   = input.int(30, "Minuti dopo",  group="Notizie")

// ─── TIMEFRAME DATA (NO REPAINT) ──────────────────────────
// Usiamo [1] sui valori HTF + lookahead_off per evitare il repainting in live.
f_sec(_tf, _src) => request.security(syminfo.tickerid, _tf, _src[1], lookahead=barmerge.lookahead_off)

m15_high   = f_sec("15", high)
m15_low    = f_sec("15", low)
m15_close  = f_sec("15", close)
m15_open   = f_sec("15", open)
m15_atr    = f_sec("15", ta.atr(14))
m15_struct_high = f_sec("15", ta.highest(high, 20))
m15_struct_low  = f_sec("15", ta.lowest (low,  20))
h1_struct_high  = f_sec("60", ta.highest(high, 20))
h1_struct_low   = f_sec("60", ta.lowest (low,  20))
// Pool di liquidità: massimo/minimo dei bar PRECEDENTI a quello di sweep ([1] extra).
bsl_level  = f_sec("15", ta.highest(high, liq_lookback)[1])
ssl_level  = f_sec("15", ta.lowest (low,  liq_lookback)[1])
atr_val    = ta.atr(14)

// ─── MODALITÀ EFFETTIVA ───────────────────────────────────
is_conservative = mode == "Conservativo"
is_extended     = mode == "Sessione Estesa"
is_aggressive   = mode == "Aggressivo"

eff_use_session   = is_conservative              // solo conservativo usa overlap stretto
eff_force_hours   = is_extended or is_aggressive // estesa/aggressiva usano fascia 8-20
eff_cooldown_bars = is_aggressive ? 2  : cooldown_bars
eff_max_trades    = is_aggressive ? 10 : max_trades_day

// ─── LIQUIDITY SWEEP + CiSD ───────────────────────────────
// Buy-side liquidity = massimo recente (stop dei buy); sell-side = minimo recente.
// Sweep+CiSD: il bar wicka OLTRE il pool ma richiude dall'altra parte con
// corpo direzionale (displacement) = Change in State of Delivery.
liq_buf   = m15_atr * liq_buffer_atr
cisd_body = math.abs(m15_close - m15_open)
displaced = cisd_body >= m15_atr * cisd_body_mult
liq_sweep_sell = m15_high > bsl_level + liq_buf and m15_close < bsl_level and m15_close < m15_open and displaced
liq_sweep_buy  = m15_low  < ssl_level - liq_buf and m15_close > ssl_level and m15_close > m15_open and displaced

// ─── FILTRI ───────────────────────────────────────────────
h_now       = hour(time, "Europe/Rome")
session_ok  = h_now >= session_start and h_now < session_end
hours_ok    = h_now >= start_hour and h_now < end_hour
// Conservativo → overlap; Estesa/Aggressiva → fascia 8-20 forzata; altrimenti rispetta use_hours.
hour_ok     = eff_use_session ? session_ok : eff_force_hours ? hours_ok : (not use_hours or hours_ok)
atr_ok      = not use_atr or atr_val >= atr_min

current_hour = hour(time, "Europe/Rome")
current_min  = minute(time, "Europe/Rome")
current_mins = current_hour * 60 + current_min
in_news(_act, _h, _m) => _act and current_mins >= (_h*60+_m - news_before) and current_mins <= (_h*60+_m + news_after)
in_news_any = in_news(news1_active, news1_hour, news1_min) or in_news(news2_active, news2_hour, news2_min) or in_news(news3_active, news3_hour, news3_min)
news_ok     = not use_news or not in_news_any

var int last_close_bar = 0
var int trades_today   = 0
var int last_trade_day = -1
current_day = dayofmonth(time, "Europe/Rome")
new_day = ta.change(current_day) != 0

if new_day
    trades_today   := 0
    last_trade_day := current_day

if strategy.position_size[1] != 0 and strategy.position_size == 0
    last_close_bar := bar_index
    trades_today   := trades_today + 1

cooldown_ok = (bar_index - last_close_bar) >= eff_cooldown_bars
trades_ok   = trades_today < eff_max_trades

var float day_eq = na
if new_day or na(day_eq)
    day_eq := strategy.equity
day_pct = (strategy.equity - day_eq) / day_eq * 100
day_ok  = day_pct > -max_loss and day_pct < max_profit

// ─── CIRCUIT BREAKER DRAWDOWN ─────────────────────────────
var float eq_peak       = na
var int   pause_until_d = 0
var int   day_counter   = 0
if new_day
    day_counter := day_counter + 1
if na(eq_peak) or strategy.equity > eq_peak
    eq_peak := strategy.equity
dd_pct = eq_peak > 0 ? (eq_peak - strategy.equity) / eq_peak * 100 : 0.0
if use_circuit and dd_pct >= dd_threshold and day_counter >= pause_until_d
    pause_until_d := day_counter + pause_days
circuit_ok = not use_circuit or day_counter >= pause_until_d
pause_left = math.max(0, pause_until_d - day_counter)

// ─── SEGNALI (SOLO ICT) ───────────────────────────────────
common_ok  = hour_ok and atr_ok and news_ok and cooldown_ok and trades_ok and day_ok and circuit_ok and strategy.position_size == 0
final_sell = liq_sweep_sell and common_ok
final_buy  = liq_sweep_buy  and common_ok

// ─── POSITION SIZING DINAMICO ─────────────────────────────
// Calcola la qty in base al rischio % e alla distanza dello SL.
f_qty(_sl_dist) =>
    risk_cash = strategy.equity * (risk_pct / 100.0)
    _sl_dist > 0 ? risk_cash / _sl_dist : 0.0

// ─── ENTRY + SL/TP ────────────────────────────────────────
// SL oltre lo sweep (dove è stata presa la liquidità);
// TP verso la liquidità opposta (struttura M15 / H1).
var float sl_buy   = na
var float tp1_buy  = na
var float tp2_buy  = na
var float sl_sell  = na
var float tp1_sell = na
var float tp2_sell = na
var float entry_px = na
var bool  be_active = false
var int last_buy_bar  = 0
var int last_sell_bar = 0
var box tp1_box = na
var box tp2_box = na
var box sl_box  = na

if final_buy
    last_buy_bar := bar_index
    sl_buy   := m15_low - atr_val * sl_atr_mult
    tp1_buy  := m15_struct_high
    tp2_buy  := h1_struct_high
    entry_px := close
    be_active := false
    qty      = f_qty(close - sl_buy)
    strategy.entry("BUY", strategy.long, qty=qty)
    strategy.exit("BUY_EXIT", from_entry="BUY", stop=sl_buy, limit=tp2_buy)
    box.delete(tp1_box), box.delete(tp2_box), box.delete(sl_box)
    tp2_box := box.new(bar_index, tp1_buy, bar_index+50, tp2_buy, bgcolor=color.new(color.green,50), border_color=color.new(color.green,20))
    tp1_box := box.new(bar_index, close,   bar_index+50, tp1_buy, bgcolor=color.new(color.green,70), border_color=color.new(color.green,40))
    sl_box  := box.new(bar_index, sl_buy,  bar_index+50, close,   bgcolor=color.new(color.red,70),   border_color=color.new(color.red,30))

if final_sell
    last_sell_bar := bar_index
    sl_sell  := m15_high + atr_val * sl_atr_mult
    tp1_sell := m15_struct_low
    tp2_sell := h1_struct_low
    entry_px := close
    be_active := false
    qty      = f_qty(sl_sell - close)
    strategy.entry("SELL", strategy.short, qty=qty)
    strategy.exit("SELL_EXIT", from_entry="SELL", stop=sl_sell, limit=tp2_sell)
    box.delete(tp1_box), box.delete(tp2_box), box.delete(sl_box)
    tp2_box := box.new(bar_index, tp2_sell, bar_index+50, tp1_sell, bgcolor=color.new(color.green,50), border_color=color.new(color.green,20))
    tp1_box := box.new(bar_index, tp1_sell, bar_index+50, close,    bgcolor=color.new(color.green,70), border_color=color.new(color.green,40))
    sl_box  := box.new(bar_index, close,    bar_index+50, sl_sell,  bgcolor=color.new(color.red,70),   border_color=color.new(color.red,30))

// ─── PARZIALE A TP1 + BREAK-EVEN + TRAILING ───────────────
// A TP1: chiusura parziale, SL a BE, poi (se use_trail) trailing ATR.
var float trail_sl = na

if strategy.position_size > 0 and not be_active and not na(tp1_buy) and high >= tp1_buy
    strategy.close("BUY", qty_percent=tp1_pct, comment="TP1")
    if use_be
        be_active := true
        trail_sl := entry_px
        strategy.exit("BUY_EXIT", from_entry="BUY", stop=trail_sl, limit=tp2_buy)

if strategy.position_size < 0 and not be_active and not na(tp1_sell) and low <= tp1_sell
    strategy.close("SELL", qty_percent=tp1_pct, comment="TP1")
    if use_be
        be_active := true
        trail_sl := entry_px
        strategy.exit("SELL_EXIT", from_entry="SELL", stop=trail_sl, limit=tp2_sell)

// Trailing stop: dopo BE alza/abbassa lo SL seguendo l'ATR, mai indietro.
if use_trail and be_active
    if strategy.position_size > 0 and not na(trail_sl)
        new_sl = close - atr_val * trail_mult
        if new_sl > trail_sl
            trail_sl := new_sl
            strategy.exit("BUY_EXIT", from_entry="BUY", stop=trail_sl, limit=tp2_buy)
    if strategy.position_size < 0 and not na(trail_sl)
        new_sl = close + atr_val * trail_mult
        if new_sl < trail_sl
            trail_sl := new_sl
            strategy.exit("SELL_EXIT", from_entry="SELL", stop=trail_sl, limit=tp2_sell)

if strategy.position_size == 0
    trail_sl := na
    be_active := false

// ─── PLOT ────────────────────────────────────────────────
plot(bsl_level, "Buy-side liquidity",  color=color.new(color.red,   50), linewidth=1, style=plot.style_linebr)
plot(ssl_level, "Sell-side liquidity", color=color.new(color.green, 50), linewidth=1, style=plot.style_linebr)

plotshape(liq_sweep_sell, title="Sweep SELL (CiSD)", style=shape.xcross, location=location.abovebar, color=color.new(color.fuchsia,0), size=size.tiny, text="Liq")
plotshape(liq_sweep_buy,  title="Sweep BUY (CiSD)",  style=shape.xcross, location=location.belowbar, color=color.new(color.aqua,0),    size=size.tiny, text="Liq")
plotshape(bar_index == last_buy_bar,  title="BUY",  style=shape.triangleup,   location=location.belowbar, color=color.lime, size=size.large, text="BUY")
plotshape(bar_index == last_sell_bar, title="SELL", style=shape.triangledown, location=location.abovebar, color=color.red,  size=size.large, text="SELL")
bgcolor(not news_ok ? color.new(color.orange,90) : na)

// ─── ALERT ────────────────────────────────────────────────
alertcondition(final_buy,  title="GoldBot ICT BUY",  message="GoldBot ICT BUY  XAUUSD @ {{close}}")
alertcondition(final_sell, title="GoldBot ICT SELL", message="GoldBot ICT SELL XAUUSD @ {{close}}")

// ─── TABELLA ──────────────────────────────────────────────
var table t = table.new(position.middle_left, 2, 13, bgcolor=color.new(color.black,70), border_width=1, border_color=color.new(color.yellow,60))

sl_display  = strategy.position_size != 0 and not na(trail_sl) ? str.tostring(math.round(trail_sl,2)) : strategy.position_size > 0 ? str.tostring(math.round(sl_buy,2))   : strategy.position_size < 0 ? str.tostring(math.round(sl_sell,2))  : "─"
tp1_display = strategy.position_size > 0 ? str.tostring(math.round(tp1_buy,2))  : strategy.position_size < 0 ? str.tostring(math.round(tp1_sell,2)) : "─"
tp2_display = strategy.position_size > 0 ? str.tostring(math.round(tp2_buy,2))  : strategy.position_size < 0 ? str.tostring(math.round(tp2_sell,2)) : "─"
liq_txt = liq_sweep_sell ? "SWEEP SELL ▼" : liq_sweep_buy ? "SWEEP BUY ▲" : "in attesa…"
liq_col = liq_sweep_sell ? color.fuchsia : liq_sweep_buy ? color.aqua : color.gray

if barstate.islast
    mode_badge = is_aggressive ? " ⚡" : is_extended ? " 🕐" : ""
    table.cell(t, 0, 0,  "GoldBot ICT" + mode_badge,  text_color=color.yellow, text_size=size.small, bgcolor=color.new(color.black,50))
    table.cell(t, 1, 0,  "Sweep + CiSD", text_color=color.gray, text_size=size.tiny, bgcolor=color.new(color.black,50))
    table.cell(t, 0, 1,  "Buy-side liq",  text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 1,  str.tostring(math.round(bsl_level,2)), text_color=color.red, text_size=size.tiny)
    table.cell(t, 0, 2,  "Sell-side liq", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 2,  str.tostring(math.round(ssl_level,2)), text_color=color.lime, text_size=size.tiny)
    table.cell(t, 0, 3,  "Segnale",       text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 3,  liq_txt, text_color=liq_col, text_size=size.tiny)
    table.cell(t, 0, 4,  "Notizie",       text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 4,  news_ok ? "LIBERO ✅" : "PAUSA 🔴", text_color=news_ok ? color.lime : color.red, text_size=size.tiny)
    sess_label = eff_use_session ? "Sessione" : eff_force_hours ? "Orario 8-20" : "Orario"
    sess_value = hour_ok ? (eff_use_session ? "OVERLAP ✅" : "ATTIVO ✅") : "CHIUSO"
    table.cell(t, 0, 5,  sess_label, text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 5,  sess_value, text_color=hour_ok ? color.lime : color.orange, text_size=size.tiny)
    table.cell(t, 0, 6,  "ATR filtro",    text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 6,  atr_ok ? "OK ✅" : "BASSO 🔴", text_color=atr_ok ? color.lime : color.red, text_size=size.tiny)
    table.cell(t, 0, 7,  "P&L Oggi",      text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 7,  str.tostring(math.round(day_pct,2)) + "%", text_color=day_pct >= 0 ? color.lime : color.red, text_size=size.tiny)
    table.cell(t, 0, 8,  "Trade Oggi",    text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 8,  str.tostring(trades_today) + "/" + str.tostring(eff_max_trades), text_color=trades_ok ? color.lime : color.orange, text_size=size.tiny)
    table.cell(t, 0, 9,  "SL/TP1/TP2",    text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 9,  sl_display + "/" + tp1_display + "/" + tp2_display, text_color=color.silver, text_size=size.tiny)
    pos_tag = be_active ? (use_trail ? " TRAIL" : " BE") : ""
    table.cell(t, 0, 10, "Posizione",     text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 10, strategy.position_size > 0 ? "LONG 🟢" + pos_tag : strategy.position_size < 0 ? "SHORT 🔴" + pos_tag : "FLAT ⚪", text_color=strategy.position_size > 0 ? color.lime : strategy.position_size < 0 ? color.red : color.white, text_size=size.tiny)
    table.cell(t, 0, 11, "DD / Status",   text_color=color.gray, text_size=size.tiny)
    circuit_txt = circuit_ok ? ("ACTIVE ✅  " + str.tostring(math.round(dd_pct,1)) + "%") : ("PAUSED 🛑 " + str.tostring(pause_left) + "g")
    table.cell(t, 1, 11, circuit_txt, text_color=circuit_ok ? color.lime : color.red, text_size=size.tiny)
    table.cell(t, 0, 12, "Cooldown",      text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 12, cooldown_ok ? "PRONTO ✅" : "ATTESA ⏳", text_color=cooldown_ok ? color.lime : color.orange, text_size=size.tiny)
