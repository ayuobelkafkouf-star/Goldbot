//@version=5
strategy("GoldBot SMC v6", shorttitle="GoldBot SMC", overlay=true,
  default_qty_type=strategy.percent_of_equity, default_qty_value=10,
  commission_type=strategy.commission.cash_per_contract, commission_value=0.35,
  slippage=5, margin_long=100, margin_short=100,
  calc_on_every_tick=false, process_orders_on_close=true)

// ═══════════════════════════════════════════════════════════
// GOLDBOT SMC — Smart Money Concepts pure
// Strategia basata su: Market Structure (BOS/CHoCH), Order Block,
// Fair Value Gap (FVG), Liquidity Sweep.
// Niente score 0-100, niente spike+body, niente EMA crossover.
// Solo logica istituzionale.
// ═══════════════════════════════════════════════════════════

// ─── INPUTS ───────────────────────────────────────────────
mode = input.string("Bilanciato", "Modalità",
   options=["Conservativo", "Bilanciato", "Aggressivo"],
   group="Modalità",
   tooltip="Conservativo: solo dopo CHoCH + retest, 1 entry per struttura. Bilanciato: BOS continuation + retest. Aggressivo: anche solo retest in trend.")

// Market Structure
pivot_len      = input.int(7,  "Pivot length (struttura)", group="Struttura", minval=2, maxval=20, tooltip="Lookback per identificare swing high/low. Maggiore = swing più significativi ma meno frequenti.")
struct_max     = input.int(10, "Max swing tracciati per lato", group="Struttura", minval=3, maxval=30)

// Order Block / FVG
ob_age_max     = input.int(50, "Età max Order Block (barre)", group="SMC", minval=10, maxval=200)
fvg_age_max    = input.int(40, "Età max FVG (barre)",         group="SMC", minval=5,  maxval=100)
sweep_lookback = input.int(15, "Lookback Liquidity Sweep",    group="SMC", minval=5,  maxval=50)
require_sweep  = input.bool(true, "Richiedi Sweep prima dell'entry", group="SMC", tooltip="Se ON, entra solo se c'è stato un liquidity sweep recente (cattura solo reversal puliti).")

// Rischio
risk_pct       = input.float(0.5, "Rischio % per trade",   group="Rischio", minval=0.1, maxval=3.0, step=0.1)
sl_buffer_atr  = input.float(0.5, "SL buffer oltre OB (ATR)", group="Rischio", minval=0.1, maxval=2.0, step=0.1)
tp1_pct        = input.float(50,  "% chiusura TP1",         group="Rischio", minval=10,  maxval=90)
rr_tp2         = input.float(4.0, "R:R per TP2",            group="Rischio", minval=1.0, maxval=10.0, step=0.5)
use_be         = input.bool(true, "Break-even dopo TP1",    group="Rischio")
use_trail      = input.bool(true, "Trailing dopo TP1",      group="Rischio")
trail_mult     = input.float(1.5, "Trailing ATR mult",      group="Rischio", minval=0.5, maxval=5.0, step=0.1)

// Filtri operativi
use_session    = input.bool(true,  "Filtro sessione (Londra/NY 8-20 Roma)", group="Filtri")
sess_start     = input.int(8,  "Sessione start (Roma)", group="Filtri", minval=0, maxval=23)
sess_end       = input.int(20, "Sessione end (Roma)",   group="Filtri", minval=0, maxval=23)
use_atr_filt   = input.bool(true,  "Filtro ATR minimo", group="Filtri")
atr_min        = input.float(1.5,  "ATR minimo", group="Filtri")
cd_bars        = input.int(5,      "Cooldown barre dopo trade", group="Filtri", minval=0, maxval=50)
enable_max_tr  = input.bool(true,  "Limita trade giornalieri", group="Filtri")
max_tr_day     = input.int(6,      "Max trade giorno", group="Filtri", minval=1, maxval=30)
max_loss_pct   = input.float(2.0,  "Max perdita % giorno", group="Filtri", minval=0.5, maxval=10.0, step=0.5)
max_profit_pct = input.float(4.0,  "Max profitto % giorno", group="Filtri", minval=0.5, maxval=20.0, step=0.5)

// Protezione
use_circuit    = input.bool(true,  "Circuit breaker drawdown", group="Protezione")
dd_threshold   = input.float(5.0,  "DD max % dal peak", group="Protezione", minval=1.0, maxval=20.0, step=0.5)
pause_days     = input.int(3,      "Giorni pausa dopo trigger", group="Protezione", minval=1, maxval=14)

// News
use_news       = input.bool(true,  "Filtro notizie", group="Notizie")
n1_act         = input.bool(true,  "Notizia 1 attiva", group="Notizie")
n1_h           = input.int(14, "N1 ora", group="Notizie")
n1_m           = input.int(30, "N1 min", group="Notizie")
n2_act         = input.bool(false, "Notizia 2 attiva", group="Notizie")
n2_h           = input.int(20, "N2 ora", group="Notizie")
n2_m           = input.int(0,  "N2 min", group="Notizie")
news_before    = input.int(30, "Min prima news", group="Notizie")
news_after     = input.int(30, "Min dopo news",  group="Notizie")

// Visual
show_struct    = input.bool(true,  "Mostra struttura (HH/HL/LH/LL)", group="Visuale")
show_ob        = input.bool(true,  "Mostra Order Block", group="Visuale")
show_fvg       = input.bool(true,  "Mostra FVG", group="Visuale")
show_sweep     = input.bool(true,  "Mostra Liquidity Sweep", group="Visuale")
show_debug     = input.bool(true,  "Mostra debug filtri", group="Visuale")

// ─── HTF DATA (no repaint) ────────────────────────────────
f_sec(_tf, _src) => request.security(syminfo.tickerid, _tf, _src[1], lookahead=barmerge.lookahead_off)
atr_val = ta.atr(14)
h1_atr  = f_sec("60", ta.atr(14))

// ─── MARKET STRUCTURE ─────────────────────────────────────
// Identifica swing high/low confermati con pivot, traccia la struttura,
// rileva BOS (continuation) e CHoCH (reversal).
ph_val = ta.pivothigh(high, pivot_len, pivot_len)
pl_val = ta.pivotlow (low,  pivot_len, pivot_len)

var array<float> swing_highs = array.new<float>()
var array<int>   swing_high_bars = array.new<int>()
var array<float> swing_lows  = array.new<float>()
var array<int>   swing_low_bars  = array.new<int>()

if not na(ph_val)
    array.push(swing_highs, ph_val)
    array.push(swing_high_bars, bar_index - pivot_len)
    if array.size(swing_highs) > struct_max
        array.shift(swing_highs)
        array.shift(swing_high_bars)

if not na(pl_val)
    array.push(swing_lows, pl_val)
    array.push(swing_low_bars, bar_index - pivot_len)
    if array.size(swing_lows) > struct_max
        array.shift(swing_lows)
        array.shift(swing_low_bars)

last_swing_high = array.size(swing_highs) > 0 ? array.get(swing_highs, array.size(swing_highs)-1) : na
last_swing_low  = array.size(swing_lows)  > 0 ? array.get(swing_lows,  array.size(swing_lows)-1)  : na
last_swing_high_bar = array.size(swing_high_bars) > 0 ? array.get(swing_high_bars, array.size(swing_high_bars)-1) : 0
last_swing_low_bar  = array.size(swing_low_bars)  > 0 ? array.get(swing_low_bars,  array.size(swing_low_bars)-1)  : 0

// Struttura corrente: bullish se ultimo swing high rotto al rialzo, bearish se ultimo swing low rotto al ribasso
var int structure = 0  // 1 = bullish, -1 = bearish, 0 = neutra
var float last_bos_level = na
var bool  bos_event   = false   // true sulla candela di BOS (continuation)
var bool  choch_event = false   // true sulla candela di CHoCH (reversal)
bos_event   := false
choch_event := false

if not na(last_swing_high) and close > last_swing_high and bar_index > last_swing_high_bar
    if structure == 1
        bos_event := true
    else if structure == -1 or structure == 0
        choch_event := true
        structure := 1
    structure := 1
    last_bos_level := last_swing_high

if not na(last_swing_low) and close < last_swing_low and bar_index > last_swing_low_bar
    if structure == -1
        bos_event := true
    else if structure == 1 or structure == 0
        choch_event := true
        structure := -1
    structure := -1
    last_bos_level := last_swing_low

bull_struct = structure == 1
bear_struct = structure == -1

// ─── ORDER BLOCK ──────────────────────────────────────────
// Bull OB: ultima candela ribassista prima del movimento up che ha fatto BOS/CHoCH bullish
// Bear OB: ultima candela rialzista prima del movimento down che ha fatto BOS/CHoCH bearish
var float bull_ob_top = na
var float bull_ob_bot = na
var int   bull_ob_bar = 0
var box   bull_ob_box = na
var float bear_ob_top = na
var float bear_ob_bot = na
var int   bear_ob_bar = 0
var box   bear_ob_box = na

f_find_last_bear_candle() =>
    int   found_idx  = -1
    float found_high = na
    float found_low  = na
    for i = 1 to 30
        if close[i] < open[i]
            found_idx := i
            found_high := high[i]
            found_low  := low[i]
            break
    [found_idx, found_high, found_low]

f_find_last_bull_candle() =>
    int   found_idx  = -1
    float found_high = na
    float found_low  = na
    for i = 1 to 30
        if close[i] > open[i]
            found_idx := i
            found_high := high[i]
            found_low  := low[i]
            break
    [found_idx, found_high, found_low]

if (bos_event or choch_event) and structure == 1
    [idx, oh, ol] = f_find_last_bear_candle()
    if idx > 0
        box.delete(bull_ob_box)
        bull_ob_top := oh
        bull_ob_bot := ol
        bull_ob_bar := bar_index - idx
        if show_ob
            bull_ob_box := box.new(bull_ob_bar, bull_ob_top, bull_ob_bar + ob_age_max, bull_ob_bot, bgcolor=color.new(color.green, 80), border_color=color.new(color.green, 30), text="Bull OB", text_size=size.tiny, text_color=color.green)

if (bos_event or choch_event) and structure == -1
    [idx, oh, ol] = f_find_last_bull_candle()
    if idx > 0
        box.delete(bear_ob_box)
        bear_ob_top := oh
        bear_ob_bot := ol
        bear_ob_bar := bar_index - idx
        if show_ob
            bear_ob_box := box.new(bear_ob_bar, bear_ob_top, bear_ob_bar + ob_age_max, bear_ob_bot, bgcolor=color.new(color.red, 80), border_color=color.new(color.red, 30), text="Bear OB", text_size=size.tiny, text_color=color.red)

bull_ob_alive = not na(bull_ob_top) and (bar_index - bull_ob_bar) <= ob_age_max
bear_ob_alive = not na(bear_ob_top) and (bar_index - bear_ob_bar) <= ob_age_max

// Invalida OB se attraversato con forza (chiusura oltre)
if bull_ob_alive and close < bull_ob_bot
    bull_ob_top := na
    bull_ob_bot := na
    box.delete(bull_ob_box)

if bear_ob_alive and close > bear_ob_top
    bear_ob_top := na
    bear_ob_bot := na
    box.delete(bear_ob_box)

// Retest dell'OB: prezzo torna dentro la zona
bull_ob_retest = bull_ob_alive and low  <= bull_ob_top and low  >= bull_ob_bot
bear_ob_retest = bear_ob_alive and high >= bear_ob_bot and high <= bear_ob_top

// ─── FVG (Fair Value Gap) ─────────────────────────────────
// Bull FVG: low[0] > high[2]  → gap nel mezzo (candela centrale)
// Bear FVG: high[0] < low[2]
bull_fvg_form = low  > high[2]
bear_fvg_form = high < low[2]

var float bull_fvg_top = na
var float bull_fvg_bot = na
var int   bull_fvg_bar = 0
var box   bull_fvg_box = na
var float bear_fvg_top = na
var float bear_fvg_bot = na
var int   bear_fvg_bar = 0
var box   bear_fvg_box = na

if bull_fvg_form
    box.delete(bull_fvg_box)
    bull_fvg_top := low
    bull_fvg_bot := high[2]
    bull_fvg_bar := bar_index
    if show_fvg
        bull_fvg_box := box.new(bar_index, bull_fvg_top, bar_index + fvg_age_max, bull_fvg_bot, bgcolor=color.new(color.aqua, 80), border_color=color.new(color.aqua, 30), text="FVG", text_size=size.tiny, text_color=color.aqua)

if bear_fvg_form
    box.delete(bear_fvg_box)
    bear_fvg_top := low[2]
    bear_fvg_bot := high
    bear_fvg_bar := bar_index
    if show_fvg
        bear_fvg_box := box.new(bar_index, bear_fvg_top, bar_index + fvg_age_max, bear_fvg_bot, bgcolor=color.new(color.fuchsia, 80), border_color=color.new(color.fuchsia, 30), text="FVG", text_size=size.tiny, text_color=color.fuchsia)

bull_fvg_alive  = not na(bull_fvg_top) and (bar_index - bull_fvg_bar) <= fvg_age_max
bear_fvg_alive  = not na(bear_fvg_top) and (bar_index - bear_fvg_bar) <= fvg_age_max
bull_fvg_retest = bull_fvg_alive and low  <= bull_fvg_top and low  >= bull_fvg_bot
bear_fvg_retest = bear_fvg_alive and high >= bear_fvg_bot and high <= bear_fvg_top

// ─── LIQUIDITY SWEEP ──────────────────────────────────────
swing_high_sw = ta.highest(high[1], sweep_lookback)
swing_low_sw  = ta.lowest (low [1], sweep_lookback)
bull_sweep = low  < swing_low_sw  and close > swing_low_sw  and close > open
bear_sweep = high > swing_high_sw and close < swing_high_sw and close < open

var bool recent_bull_sweep = false
var bool recent_bear_sweep = false
var int  bull_sweep_bar = 0
var int  bear_sweep_bar = 0
sweep_validity = 10
if bull_sweep
    recent_bull_sweep := true
    bull_sweep_bar := bar_index
if bear_sweep
    recent_bear_sweep := true
    bear_sweep_bar := bar_index
if recent_bull_sweep and (bar_index - bull_sweep_bar) > sweep_validity
    recent_bull_sweep := false
if recent_bear_sweep and (bar_index - bear_sweep_bar) > sweep_validity
    recent_bear_sweep := false

// ─── FILTRI OPERATIVI ─────────────────────────────────────
h_now      = hour(time, "Europe/Rome")
sess_ok    = not use_session or (h_now >= sess_start and h_now < sess_end)
atr_ok     = not use_atr_filt or atr_val >= atr_min

cur_h      = hour(time, "Europe/Rome")
cur_m      = minute(time, "Europe/Rome")
cur_mins   = cur_h * 60 + cur_m
in_news_fn(_act, _h, _m) => _act and cur_mins >= (_h*60+_m - news_before) and cur_mins <= (_h*60+_m + news_after)
in_news_any = in_news_fn(n1_act, n1_h, n1_m) or in_news_fn(n2_act, n2_h, n2_m)
news_ok    = not use_news or not in_news_any

var int  last_close_bar = 0
var int  trades_today   = 0
cur_day = dayofmonth(time, "Europe/Rome")
new_day = ta.change(cur_day) != 0
if new_day
    trades_today := 0
if strategy.position_size[1] != 0 and strategy.position_size == 0
    last_close_bar := bar_index
    trades_today   := trades_today + 1
cd_ok       = (bar_index - last_close_bar) >= cd_bars
trades_ok   = not enable_max_tr or trades_today < max_tr_day

var float day_eq = na
if new_day or na(day_eq)
    day_eq := strategy.equity
day_pct = (strategy.equity - day_eq) / day_eq * 100
day_ok  = day_pct > -max_loss_pct and day_pct < max_profit_pct

var float eq_peak     = na
var int   pause_until = 0
var int   day_counter = 0
if new_day
    day_counter := day_counter + 1
if na(eq_peak) or strategy.equity > eq_peak
    eq_peak := strategy.equity
dd_pct = eq_peak > 0 ? (eq_peak - strategy.equity) / eq_peak * 100 : 0.0
if use_circuit and dd_pct >= dd_threshold and day_counter >= pause_until
    pause_until := day_counter + pause_days
circuit_ok = not use_circuit or day_counter >= pause_until
pause_left = math.max(0, pause_until - day_counter)

// ─── ENTRY LOGIC ──────────────────────────────────────────
// Modalità Conservativo: solo entry su CHoCH+retest (puro reversal)
// Modalità Bilanciato:   entry su retest (BOS o CHoCH) di OB/FVG
// Modalità Aggressivo:   entry su retest anche senza BOS/CHoCH recente, basta che la struttura sia favorevole
is_conservativo = mode == "Conservativo"
is_aggressivo   = mode == "Aggressivo"

// Pattern retest (qualsiasi): prezzo torna in OB o FVG nella direzione della struttura
bull_retest = bull_struct and (bull_ob_retest or bull_fvg_retest)
bear_retest = bear_struct and (bear_ob_retest or bear_fvg_retest)

// In Conservativo richiediamo che il CHoCH sia recente (entro 20 barre)
var int last_bull_choch_bar = -1000
var int last_bear_choch_bar = -1000
if choch_event and structure == 1
    last_bull_choch_bar := bar_index
if choch_event and structure == -1
    last_bear_choch_bar := bar_index
recent_bull_choch = (bar_index - last_bull_choch_bar) <= 20
recent_bear_choch = (bar_index - last_bear_choch_bar) <= 20

entry_buy_ok  = bull_retest and (is_conservativo ? recent_bull_choch : true)
entry_sell_ok = bear_retest and (is_conservativo ? recent_bear_choch : true)

// Liquidity sweep richiesto se attivato
sweep_buy_ok  = not require_sweep or recent_bull_sweep
sweep_sell_ok = not require_sweep or recent_bear_sweep

final_buy  = entry_buy_ok  and sweep_buy_ok  and sess_ok and atr_ok and news_ok and cd_ok and trades_ok and day_ok and circuit_ok and strategy.position_size == 0
final_sell = entry_sell_ok and sweep_sell_ok and sess_ok and atr_ok and news_ok and cd_ok and trades_ok and day_ok and circuit_ok and strategy.position_size == 0

// ─── POSITION SIZING + SL/TP ──────────────────────────────
f_qty(_sl_dist) =>
    risk_cash = strategy.equity * (risk_pct / 100.0)
    _sl_dist > 0 ? risk_cash / _sl_dist : 0.0

var float sl_lvl   = na
var float tp1_lvl  = na
var float tp2_lvl  = na
var float entry_px = na
var bool  be_active = false
var float trail_sl = na
var int   last_buy_bar  = 0
var int   last_sell_bar = 0
var box   tp_box = na
var box   sl_box = na

if final_buy
    last_buy_bar := bar_index
    sl_lvl   := (not na(bull_ob_bot) ? bull_ob_bot : low) - atr_val * sl_buffer_atr
    entry_px := close
    risk_dist = entry_px - sl_lvl
    tp1_lvl  := entry_px + risk_dist * 1.5
    tp2_lvl  := entry_px + risk_dist * rr_tp2
    be_active := false
    qty       = f_qty(risk_dist)
    strategy.entry("BUY", strategy.long, qty=qty)
    strategy.exit("BUY_X", from_entry="BUY", stop=sl_lvl, limit=tp2_lvl)
    box.delete(tp_box), box.delete(sl_box)
    tp_box := box.new(bar_index, entry_px, bar_index+50, tp2_lvl, bgcolor=color.new(color.green,70), border_color=color.new(color.green,30))
    sl_box := box.new(bar_index, sl_lvl,   bar_index+50, entry_px, bgcolor=color.new(color.red,70),   border_color=color.new(color.red,30))
    alert("🟢 GoldBot SMC BUY XAUUSD" +
          "\nEntry: " + str.tostring(entry_px, "#.##") +
          "\nSL: "    + str.tostring(sl_lvl,   "#.##") +
          "\nTP1: "   + str.tostring(tp1_lvl,  "#.##") +
          "\nTP2: "   + str.tostring(tp2_lvl,  "#.##") +
          "\nTrigger: " + (bull_ob_retest ? "OB retest" : "FVG retest") +
          (recent_bull_sweep ? " + Sweep" : "") +
          "\nMode: " + mode, alert.freq_once_per_bar_close)

if final_sell
    last_sell_bar := bar_index
    sl_lvl   := (not na(bear_ob_top) ? bear_ob_top : high) + atr_val * sl_buffer_atr
    entry_px := close
    risk_dist = sl_lvl - entry_px
    tp1_lvl  := entry_px - risk_dist * 1.5
    tp2_lvl  := entry_px - risk_dist * rr_tp2
    be_active := false
    qty       = f_qty(risk_dist)
    strategy.entry("SELL", strategy.short, qty=qty)
    strategy.exit("SELL_X", from_entry="SELL", stop=sl_lvl, limit=tp2_lvl)
    box.delete(tp_box), box.delete(sl_box)
    tp_box := box.new(bar_index, tp2_lvl, bar_index+50, entry_px, bgcolor=color.new(color.green,70), border_color=color.new(color.green,30))
    sl_box := box.new(bar_index, entry_px, bar_index+50, sl_lvl,  bgcolor=color.new(color.red,70),   border_color=color.new(color.red,30))
    alert("🔴 GoldBot SMC SELL XAUUSD" +
          "\nEntry: " + str.tostring(entry_px, "#.##") +
          "\nSL: "    + str.tostring(sl_lvl,   "#.##") +
          "\nTP1: "   + str.tostring(tp1_lvl,  "#.##") +
          "\nTP2: "   + str.tostring(tp2_lvl,  "#.##") +
          "\nTrigger: " + (bear_ob_retest ? "OB retest" : "FVG retest") +
          (recent_bear_sweep ? " + Sweep" : "") +
          "\nMode: " + mode, alert.freq_once_per_bar_close)

// ─── TP1 PARTIAL + BE + TRAIL ─────────────────────────────
if strategy.position_size > 0 and not be_active and not na(tp1_lvl) and high >= tp1_lvl
    strategy.close("BUY", qty_percent=tp1_pct, comment="TP1")
    if use_be
        be_active := true
        trail_sl := entry_px
        strategy.exit("BUY_X", from_entry="BUY", stop=trail_sl, limit=tp2_lvl)

if strategy.position_size < 0 and not be_active and not na(tp1_lvl) and low <= tp1_lvl
    strategy.close("SELL", qty_percent=tp1_pct, comment="TP1")
    if use_be
        be_active := true
        trail_sl := entry_px
        strategy.exit("SELL_X", from_entry="SELL", stop=trail_sl, limit=tp2_lvl)

if use_trail and be_active
    if strategy.position_size > 0 and not na(trail_sl)
        new_sl = close - atr_val * trail_mult
        if new_sl > trail_sl
            trail_sl := new_sl
            strategy.exit("BUY_X", from_entry="BUY", stop=trail_sl, limit=tp2_lvl)
    if strategy.position_size < 0 and not na(trail_sl)
        new_sl = close + atr_val * trail_mult
        if new_sl < trail_sl
            trail_sl := new_sl
            strategy.exit("SELL_X", from_entry="SELL", stop=trail_sl, limit=tp2_lvl)

if strategy.position_size == 0
    trail_sl := na
    be_active := false

// ─── VISUALI: STRUTTURA, BOS, CHoCH, SWEEP ────────────────
if show_struct and not na(ph_val)
    label.new(bar_index - pivot_len, ph_val + atr_val*0.3, structure == 1 ? "HH" : "LH", style=label.style_label_down, color=color.new(structure == 1 ? color.lime : color.orange, 20), textcolor=color.white, size=size.tiny)
if show_struct and not na(pl_val)
    label.new(bar_index - pivot_len, pl_val - atr_val*0.3, structure == -1 ? "LL" : "HL", style=label.style_label_up, color=color.new(structure == -1 ? color.red : color.aqua, 20), textcolor=color.white, size=size.tiny)

if bos_event
    label.new(bar_index, close, "BOS", style=label.style_label_left, color=color.new(color.yellow, 20), textcolor=color.black, size=size.small)
if choch_event
    label.new(bar_index, close, "CHoCH", style=label.style_label_left, color=color.new(color.fuchsia, 10), textcolor=color.white, size=size.small)

plotshape(show_sweep and bull_sweep, title="Bull Sweep", style=shape.diamond, location=location.belowbar, color=color.aqua,    size=size.tiny, text="SW")
plotshape(show_sweep and bear_sweep, title="Bear Sweep", style=shape.diamond, location=location.abovebar, color=color.fuchsia, size=size.tiny, text="SW")

plotshape(bar_index == last_buy_bar,  title="BUY",  style=shape.triangleup,   location=location.belowbar, color=color.lime, size=size.large, text="BUY")
plotshape(bar_index == last_sell_bar, title="SELL", style=shape.triangledown, location=location.abovebar, color=color.red,  size=size.large, text="SELL")
bgcolor(not news_ok ? color.new(color.orange, 92) : na)

// Plot per alert {{plot_X}}
plot_sl_b  = final_buy  ? sl_lvl  : na
plot_tp1_b = final_buy  ? tp1_lvl : na
plot_tp2_b = final_buy  ? tp2_lvl : na
plot_sl_s  = final_sell ? sl_lvl  : na
plot_tp1_s = final_sell ? tp1_lvl : na
plot_tp2_s = final_sell ? tp2_lvl : na
plot(plot_sl_b,  "SL Buy",  display=display.none)
plot(plot_tp1_b, "TP1 Buy", display=display.none)
plot(plot_tp2_b, "TP2 Buy", display=display.none)
plot(plot_sl_s,  "SL Sell", display=display.none)
plot(plot_tp1_s, "TP1 Sell",display=display.none)
plot(plot_tp2_s, "TP2 Sell",display=display.none)

alertcondition(final_buy,  title="GoldBot SMC BUY",  message="🟢 BUY {{ticker}} {{interval}} Entry:{{close}} SL:{{plot_0}} TP1:{{plot_1}} TP2:{{plot_2}}")
alertcondition(final_sell, title="GoldBot SMC SELL", message="🔴 SELL {{ticker}} {{interval}} Entry:{{close}} SL:{{plot_3}} TP1:{{plot_4}} TP2:{{plot_5}}")

// ─── DEBUG LABEL ──────────────────────────────────────────
var label dbg = na
if barstate.islast and show_debug
    label.delete(dbg)
    struct_txt = bull_struct ? "🟢 BULLISH" : bear_struct ? "🔴 BEARISH" : "⚪ NEUTRAL"
    buy_lines  = ""
    buy_lines += (bull_struct           ? "✅" : "❌") + " Struttura bull\n"
    buy_lines += (bull_ob_alive         ? "✅" : "❌") + " Bull OB attivo\n"
    buy_lines += (bull_ob_retest        ? "✅" : "❌") + " Retest OB\n"
    buy_lines += (bull_fvg_alive        ? "✅" : "❌") + " Bull FVG attivo\n"
    buy_lines += (bull_fvg_retest       ? "✅" : "❌") + " Retest FVG\n"
    buy_lines += (recent_bull_sweep     ? "✅" : "⚪") + " Sweep recente\n"
    buy_lines += (is_conservativo ? (recent_bull_choch ? "✅" : "❌") + " CHoCH recente\n" : "")
    sell_lines = ""
    sell_lines += (bear_struct          ? "✅" : "❌") + " Struttura bear\n"
    sell_lines += (bear_ob_alive        ? "✅" : "❌") + " Bear OB attivo\n"
    sell_lines += (bear_ob_retest       ? "✅" : "❌") + " Retest OB\n"
    sell_lines += (bear_fvg_alive       ? "✅" : "❌") + " Bear FVG attivo\n"
    sell_lines += (bear_fvg_retest      ? "✅" : "❌") + " Retest FVG\n"
    sell_lines += (recent_bear_sweep    ? "✅" : "⚪") + " Sweep recente\n"
    sell_lines += (is_conservativo ? (recent_bear_choch ? "✅" : "❌") + " CHoCH recente\n" : "")
    common = ""
    common += (sess_ok     ? "✅" : "❌") + " Sessione\n"
    common += (atr_ok      ? "✅" : "❌") + " ATR " + str.tostring(math.round(atr_val,2)) + "\n"
    common += (news_ok     ? "✅" : "❌") + " Notizie\n"
    common += (cd_ok       ? "✅" : "❌") + " Cooldown\n"
    common += (trades_ok   ? "✅" : "❌") + " Trade " + str.tostring(trades_today) + "/" + str.tostring(max_tr_day) + "\n"
    common += (day_ok      ? "✅" : "❌") + " P&L " + str.tostring(math.round(day_pct,2)) + "%\n"
    common += (circuit_ok  ? "✅" : "❌") + " Circuit\n"
    flat = strategy.position_size == 0
    pos_txt = flat ? "✅ Flat" : "❌ In posizione"
    title = final_buy ? "🟢 ENTRY BUY!" : final_sell ? "🔴 ENTRY SELL!" : "⏸️ NO ENTRY"
    txt = title + "\nStruttura: " + struct_txt + "\n──── BUY ────\n" + buy_lines + "──── SELL ────\n" + sell_lines + "──── COMUNI ────\n" + common + pos_txt
    dbg := label.new(bar_index, high + atr_val * 2, txt, style=label.style_label_left, color=color.new(color.black, 15), textcolor=color.white, size=size.small)

// ─── TABELLA STATO ────────────────────────────────────────
var table t = table.new(position.middle_left, 2, 14, bgcolor=color.new(color.black, 70), border_width=1, border_color=color.new(color.yellow, 60))
sl_disp  = strategy.position_size != 0 and not na(trail_sl) ? str.tostring(math.round(trail_sl,2)) : strategy.position_size != 0 ? str.tostring(math.round(sl_lvl,2)) : "─"
tp1_disp = strategy.position_size != 0 ? str.tostring(math.round(tp1_lvl,2)) : "─"
tp2_disp = strategy.position_size != 0 ? str.tostring(math.round(tp2_lvl,2)) : "─"
if barstate.islast
    table.cell(t, 0, 0,  "GoldBot SMC v6 🧠", text_color=color.yellow, text_size=size.small, bgcolor=color.new(color.black,50))
    table.cell(t, 1, 0,  mode,               text_color=color.aqua,   text_size=size.tiny,  bgcolor=color.new(color.black,50))
    table.cell(t, 0, 1,  "Struttura",     text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 1,  bull_struct ? "BULLISH ▲" : bear_struct ? "BEARISH ▼" : "NEUTRAL", text_color=bull_struct ? color.lime : bear_struct ? color.red : color.gray, text_size=size.tiny)
    table.cell(t, 0, 2,  "Bull OB", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 2,  bull_ob_alive ? str.tostring(math.round(bull_ob_bot,2)) + "-" + str.tostring(math.round(bull_ob_top,2)) : "─", text_color=bull_ob_alive ? color.lime : color.gray, text_size=size.tiny)
    table.cell(t, 0, 3,  "Bear OB", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 3,  bear_ob_alive ? str.tostring(math.round(bear_ob_bot,2)) + "-" + str.tostring(math.round(bear_ob_top,2)) : "─", text_color=bear_ob_alive ? color.red : color.gray, text_size=size.tiny)
    table.cell(t, 0, 4,  "Bull FVG", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 4,  bull_fvg_alive ? str.tostring(math.round(bull_fvg_bot,2)) + "-" + str.tostring(math.round(bull_fvg_top,2)) : "─", text_color=bull_fvg_alive ? color.aqua : color.gray, text_size=size.tiny)
    table.cell(t, 0, 5,  "Bear FVG", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 5,  bear_fvg_alive ? str.tostring(math.round(bear_fvg_bot,2)) + "-" + str.tostring(math.round(bear_fvg_top,2)) : "─", text_color=bear_fvg_alive ? color.fuchsia : color.gray, text_size=size.tiny)
    table.cell(t, 0, 6,  "Sweep recente", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 6,  recent_bull_sweep ? "🔼 BULL" : recent_bear_sweep ? "🔽 BEAR" : "─", text_color=recent_bull_sweep ? color.aqua : recent_bear_sweep ? color.fuchsia : color.gray, text_size=size.tiny)
    table.cell(t, 0, 7,  "Notizie", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 7,  news_ok ? "LIBERO ✅" : "PAUSA 🔴", text_color=news_ok ? color.lime : color.red, text_size=size.tiny)
    table.cell(t, 0, 8,  "Sessione", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 8,  sess_ok ? "ATTIVA ✅" : "CHIUSA",   text_color=sess_ok ? color.lime : color.orange, text_size=size.tiny)
    table.cell(t, 0, 9,  "P&L Oggi", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 9,  str.tostring(math.round(day_pct,2)) + "%", text_color=day_pct >= 0 ? color.lime : color.red, text_size=size.tiny)
    table.cell(t, 0, 10, "Trade Oggi", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 10, str.tostring(trades_today) + "/" + str.tostring(max_tr_day), text_color=trades_ok ? color.lime : color.orange, text_size=size.tiny)
    table.cell(t, 0, 11, "SL/TP1/TP2", text_color=color.gray, text_size=size.tiny)
    table.cell(t, 1, 11, sl_disp + "/" + tp1_disp + "/" + tp2_disp, text_color=color.silver, text_size=size.tiny)
    table.cell(t, 0, 12, "Posizione", text_color=color.gray, text_size=size.tiny)
    pos_tag = be_active ? (use_trail ? " TRAIL" : " BE") : ""
    table.cell(t, 1, 12, strategy.position_size > 0 ? "LONG 🟢" + pos_tag : strategy.position_size < 0 ? "SHORT 🔴" + pos_tag : "FLAT ⚪", text_color=strategy.position_size > 0 ? color.lime : strategy.position_size < 0 ? color.red : color.white, text_size=size.tiny)
    table.cell(t, 0, 13, "DD/Status", text_color=color.gray, text_size=size.tiny)
    circuit_txt = circuit_ok ? ("ACTIVE ✅ " + str.tostring(math.round(dd_pct,1)) + "%") : ("PAUSED 🛑 " + str.tostring(pause_left) + "g")
    table.cell(t, 1, 13, circuit_txt, text_color=circuit_ok ? color.lime : color.red, text_size=size.tiny)

// ─── BACKTEST STATS ───────────────────────────────────────
var table stats = table.new(position.top_right, 2, 10, bgcolor=color.new(color.black, 70), border_width=1, border_color=color.new(color.aqua, 60))
if barstate.islast
    closed     = strategy.closedtrades
    wins       = strategy.wintrades
    losses     = strategy.losstrades
    win_rate   = closed > 0 ? wins / closed * 100 : 0.0
    gross_p    = strategy.grossprofit
    gross_l    = strategy.grossloss
    pf         = gross_l > 0 ? gross_p / gross_l : na
    net_p      = strategy.netprofit
    net_pct    = strategy.initial_capital > 0 ? net_p / strategy.initial_capital * 100 : 0.0
    max_dd     = strategy.max_drawdown
    max_dd_pct = strategy.initial_capital > 0 ? max_dd / strategy.initial_capital * 100 : 0.0
    avg_trade  = closed > 0 ? net_p / closed : 0.0
    grade = closed < 10 ? "⚪ POCHI DATI" : pf >= 2.0 and win_rate >= 50 ? "🟢 OTTIMA" : pf >= 1.5 ? "🟡 BUONA" : pf >= 1.0 ? "🟠 OK" : "🔴 PERDENTE"
    grade_color = closed < 10 ? color.gray : pf >= 2.0 and win_rate >= 50 ? color.lime : pf >= 1.5 ? color.yellow : pf >= 1.0 ? color.orange : color.red

    table.cell(stats, 0, 0, "📊 BACKTEST",  text_color=color.aqua,   text_size=size.small, bgcolor=color.new(color.black,50))
    table.cell(stats, 1, 0, mode,           text_color=color.silver, text_size=size.tiny,  bgcolor=color.new(color.black,50))
    table.cell(stats, 0, 1, "Giudizio",     text_color=color.gray,   text_size=size.tiny)
    table.cell(stats, 1, 1, grade,          text_color=grade_color,  text_size=size.tiny)
    table.cell(stats, 0, 2, "Net Profit",   text_color=color.gray,   text_size=size.tiny)
    table.cell(stats, 1, 2, "$" + str.tostring(math.round(net_p,2)) + " (" + str.tostring(math.round(net_pct,2)) + "%)", text_color=net_p >= 0 ? color.lime : color.red, text_size=size.tiny)
    table.cell(stats, 0, 3, "Trade",        text_color=color.gray,   text_size=size.tiny)
    table.cell(stats, 1, 3, str.tostring(closed) + " (W:" + str.tostring(wins) + " L:" + str.tostring(losses) + ")", text_color=color.white, text_size=size.tiny)
    table.cell(stats, 0, 4, "Win Rate",     text_color=color.gray,   text_size=size.tiny)
    table.cell(stats, 1, 4, str.tostring(math.round(win_rate,1)) + "%", text_color=win_rate >= 50 ? color.lime : win_rate >= 40 ? color.yellow : color.red, text_size=size.tiny)
    table.cell(stats, 0, 5, "Profit Factor",text_color=color.gray,   text_size=size.tiny)
    table.cell(stats, 1, 5, na(pf) ? "─" : str.tostring(math.round(pf,2)), text_color=na(pf) ? color.gray : pf >= 1.5 ? color.lime : pf >= 1.0 ? color.yellow : color.red, text_size=size.tiny)
    table.cell(stats, 0, 6, "Max DD",       text_color=color.gray,   text_size=size.tiny)
    table.cell(stats, 1, 6, "$" + str.tostring(math.round(max_dd,2)) + " (" + str.tostring(math.round(max_dd_pct,2)) + "%)", text_color=max_dd_pct < 10 ? color.lime : max_dd_pct < 20 ? color.yellow : color.red, text_size=size.tiny)
    table.cell(stats, 0, 7, "Avg Trade",    text_color=color.gray,   text_size=size.tiny)
    table.cell(stats, 1, 7, "$" + str.tostring(math.round(avg_trade,2)), text_color=avg_trade >= 0 ? color.lime : color.red, text_size=size.tiny)
    table.cell(stats, 0, 8, "Equity",       text_color=color.gray,   text_size=size.tiny)
    table.cell(stats, 1, 8, "$" + str.tostring(math.round(strategy.equity,2)), text_color=color.silver, text_size=size.tiny)
    table.cell(stats, 0, 9, "Peak DD%",     text_color=color.gray,   text_size=size.tiny)
    table.cell(stats, 1, 9, str.tostring(math.round(dd_pct,1)) + "%", text_color=dd_pct < 3 ? color.lime : dd_pct < 5 ? color.yellow : color.red, text_size=size.tiny)
